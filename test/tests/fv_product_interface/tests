    requirement = 'The FV product flag shall remain correct on both sides of a completed interface after nonuniform initial refinement introduces coarse and fine faces.'
  []
  [coarsen]
    type = CSVDiff
    input = flag.i
    cli_args = 'Mesh/uniform_refine=1 Functions/products/expression=1 Adaptivity/initial_steps=1 Outputs/file_base=coarsen_out'
    csvdiff = coarsen_out.csv
    requirement = 'Uniform reacted FV material without a product interface shall permit coarsening of previously refined cells.'
