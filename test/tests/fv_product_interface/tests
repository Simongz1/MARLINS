  [unfinished]
    type = CSVDiff
    input = flag.i
    cli_args = 'Functions/clock_ic/expression=0 Outputs/file_base=unfinished_out'
    csvdiff = unfinished_out.csv
    requirement = 'The FV product marker shall remain inactive while neither neighboring reaction window has finished.'
  []
  [refine]
    type = CSVDiff
    input = flag.i
    cli_args = 'ICs/flag/function=interface_band Adaptivity/initial_steps=1 Outputs/file_base=refine_out'
